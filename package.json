{
  "name": "waypoint",
  "productName": "Waypoint",
  "version": "0.4.1",
  "description": "An open-source, keyboard-first command palette and launcher for macOS, Windows and Linux.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Alexander Silver",
  "homepage": "https://github.com/alexsilver8/waypoint",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:api": "pnpm --filter @waypoint-org/api build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.extensions.json && tsc -p packages/api/tsconfig.json",
    "lint": "biome check .",
    "cleaner": "pnpm dlx github:alexsilver8/cleaner#v1 src packages/api/src packages/api/scripts",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:dir": "pnpm run build && electron-builder --dir",
    "extensions:data": "node scripts/extension-data.mjs",
    "release": "node scripts/release.mjs",
    "commits:check": "node scripts/check-commits.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexsilver8/waypoint.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.64.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "emojibase-data": "17.0.0",
    "gitmojis": "3.15.0",
    "lucide-react": "^1.57.0",
    "marked": "17.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
