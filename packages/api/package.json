{
  "name": "@waypoint-org/api",
  "version": "0.0.1",
  "description": "Types and helpers for writing Waypoint extensions.",
  "keywords": [
    "waypoint",
    "launcher",
    "extension",
    "command-palette"
  ],
  "license": "MIT",
  "author": "Alexander Silver",
  "homepage": "https://github.com/alexsilver8/waypoint/blob/main/docs/extensions.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexsilver8/waypoint.git",
    "directory": "packages/api"
  },
  "bugs": "https://github.com/alexsilver8/waypoint/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --root .",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
